{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "name": "fvgd",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "installCommand": "echo skip",
  "rewrites": [
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/(.*)", "destination": "/admin/index.html" }
  ],
  "headers": [
    {
      "source": "/js/config.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
